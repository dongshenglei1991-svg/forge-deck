<Window x:Class="ForgeDeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ForgeDeck" Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize">
    <WindowChrome.WindowChrome>
        <!-- 无系统标题栏：CaptionHeight=0 隐藏字幕区，保留 8px 隐形调整边框 -->
        <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" ResizeBorderThickness="8"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root">
        <wv2:WebView2 x:Name="Web" />
    </Grid>
</Window>
